/* Estilos da TUI do code-cards */

Screen {
    padding: 0 1;
}

#app-title {
    text-style: bold;
    color: $accent;
    padding: 1 1 0 1;
    border-bottom: solid $panel-lighten-2;
}

#welcome {
    padding: 1 2;
}

#deck-list {
    margin-top: 1;
    height: auto;
    max-height: 1fr;
    border: none;
    padding: 0 0;
    background: transparent;
}

.help-bar {
    dock: bottom;
    height: auto;
    padding: 0 1;
    border-top: solid $panel-lighten-2;
    color: $text-muted;
}

/* Estudo */

#study-header {
    height: 1;
    margin: 1 0 1 0;
}

#deck-name {
    width: 1fr;
}

#counts {
    width: auto;
}

#code {
    height: 1fr;
    min-height: 5;
    border: round $accent;
    border-title-color: $text-muted;
}

#description-box {
    height: auto;
    max-height: 40%;
    border: round $success;
    border-title-color: $text-muted;
    padding: 0 1;
}

#done {
    padding: 2;
    height: auto;
    text-align: center;
}

/* Diálogos */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.modal {
    width: 64;
    height: auto;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

.modal-message {
    width: 100%;
    margin-bottom: 1;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 1;
}

/* Editor de card */

#editor-selects {
    height: auto;
    margin: 1 0 0 0;
}

#editor-selects > Vertical {
    height: auto;
    width: 1fr;
    margin-right: 1;
}

#code-editor {
    height: 2fr;
    min-height: 6;
    border: round $accent;
    border-title-color: $text-muted;
}

#description-editor {
    height: 1fr;
    min-height: 4;
    border: round $success;
    border-title-color: $text-muted;
}

#tags-input {
    margin-bottom: 1;
}

/* Gerenciar deck */

#card-table {
    height: 1fr;
    margin-top: 1;
}

#empty-deck {
    padding: 1 2;
}

/* Configurações */

#settings-body {
    height: 1fr;
}

.settings-section {
    text-style: bold;
    color: $accent;
    margin: 1 0 0 0;
}

.settings-row {
    height: auto;
    margin: 0 0 0 2;
}

.settings-label {
    width: 36;
}

.key-button {
    width: 22;
    margin: 0 1 0 0;
}

.settings-header {
    height: 1;
    margin-top: 1;
}

.settings-header .settings-section {
    margin: 0;
}

.column-title {
    width: 23;
    text-align: center;
    color: $text-muted;
}

Switch {
    border: none;
    padding: 0;
    height: 1;
}

.key-button.capturing {
    background: $warning;
    color: $text;
}

Input.number {
    width: 16;
    margin-bottom: 1;
}

#reset {
    margin-top: 1;
}
