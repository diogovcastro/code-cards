/* Estilos da TUI do code-cards */

Screen {
    padding: 0 1;
}

#app-title {
    text-style: bold;
    color: $accent;
    padding: 1 1 0 1;
    border-bottom: solid $panel-lighten-2;
}

#welcome {
    padding: 1 2;
}

#deck-list {
    margin-top: 1;
    height: auto;
    max-height: 1fr;
    border: none;
    padding: 0 0;
    background: transparent;
}

.help-bar {
    dock: bottom;
    height: auto;
    padding: 0 1;
    border-top: solid $panel-lighten-2;
    color: $text-muted;
}
